{
  "expo": {
    "name": "LUNQRA",
    "slug": "lunqra",
    "version": "0.1.0",
    "scheme": "lunqra",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
